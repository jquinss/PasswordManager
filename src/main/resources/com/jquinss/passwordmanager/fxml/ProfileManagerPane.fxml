<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane id="user-profiles-pane" prefHeight="500.0" prefWidth="540.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jquinss.passwordmanager.controllers.ProfileManagerPaneController">
<top>
    <Label styleClass="main-menu-content-title" text="Manage Profiles">
        <BorderPane.margin>
            <Insets bottom="20" />
        </BorderPane.margin>
    </Label>
</top>

<center>
    <TableView fx:id="userProfilesTableView">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <Label text="No profiles have been created" />
        </placeholder>
        <columns>
            <TableColumn fx:id="userProfileNameTableColumn" prefWidth="242" resizable="false" text="Name" />
            <TableColumn fx:id="isDefaultUserProfileTableColumn" prefWidth="243" resizable="false" text="Default" />
        </columns>
        <BorderPane.margin>
            <Insets bottom="20" />
        </BorderPane.margin>
    </TableView>
</center>

<bottom>
    <VBox>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button onAction="#openProfileSelectionDialog" prefHeight="40" prefWidth="200" styleClass="btn" text="Back to Profile Selection..." />
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="250.0" spacing="15.0">
               <children>
                  <Button onAction="#addUserProfile" prefHeight="40" prefWidth="80.0" styleClass="btn, dialog-btn" text="Add" />
                  <Button onAction="#deleteUserProfile" prefHeight="40" prefWidth="80.0" styleClass="btn, dialog-btn" text="Delete" />
               </children>
            </HBox>
        </HBox>
        <HBox alignment="BOTTOM_RIGHT">
            <Label fx:id="message" text="Placeholder" visible="false" />
        </HBox>
    </VBox>
</bottom>
</BorderPane>
